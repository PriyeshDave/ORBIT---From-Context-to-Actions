# Copy this file to .env in the project root (same folder as
# docker-compose.yml) before running `docker compose up --build`.
# This is the file Docker Compose actually reads - backend/.env.example
# is only for running the backend directly (without Docker).

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORCHESTRATOR_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=900

# --- LangSmith (optional - all three capabilities degrade gracefully without it) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orbit-demo
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- App ---
APP_ENV=production
CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# --- Docker Compose port mapping (host:container) ---
# Change these if 80/8000 are already in use on your VM.
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Only set these if the frontend needs to call a backend on a
# different origin than the one serving the page (see frontend/.env.example) ---
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=

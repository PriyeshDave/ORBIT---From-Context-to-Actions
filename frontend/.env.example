# Leave both of these UNSET for normal use - in production, the frontend
# makes same-origin requests and nginx forwards /api/* to the backend
# container; for local `npm run dev`, vite.config.js's dev-server proxy
# does the same thing automatically (forwarding to http://localhost:8000).
# Neither case needs anything set here.
#
# Only set these if your backend runs somewhere other than
# http://localhost:8000 during local dev, or if you need the frontend to
# call a backend on a genuinely different origin than the one serving the
# page in some other setup:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000
#
# (Separately, VITE_DEV_BACKEND_URL - not VITE_-prefixed the same way -
# can override the dev-server proxy's target if your backend isn't on
# localhost:8000; see vite.config.js.)
